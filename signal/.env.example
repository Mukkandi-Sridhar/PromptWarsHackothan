# LLM Provider: anthropic | openai | google | none
LLM_PROVIDER=anthropic

# API Keys (only the one matching LLM_PROVIDER is needed)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# Models (optional — defaults are set in config.py)
# ANTHROPIC_MODEL=claude-3-5-haiku-20241022
# OPENAI_MODEL=gpt-4o-mini
# GOOGLE_MODEL=gemini-1.5-flash

# Force deterministic (offline) mode even if API key is set
DETERMINISTIC_MODE=false

# Paths (optional — defaults are data/signal.db and data/chroma)
# DB_PATH=data/signal.db
# CHROMA_PATH=data/chroma
